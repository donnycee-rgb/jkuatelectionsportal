# Copy this file to ".env" and paste your deployed Google Apps Script Web App URL.
# This URL is PUBLIC by design (it is the API endpoint). It contains no credentials.
# The Spreadsheet ID and admin key live only inside Apps Script (Script Properties).
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional: the hash route used for the private admin dashboard.
# Not linked anywhere in the public navigation. Change it to something only the electoral team knows.
VITE_ADMIN_ROUTE=electoral-desk
